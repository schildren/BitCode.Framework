<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- F8-05 (docs/adr/0018-registry-nuget-github-packages.md): feed propio del framework en
         GitHub Packages. Fuente listada por conveniencia de restore de un consumidor externo que
         necesite resolver un paquete BitCode.Framework ya publicado; el propio repositorio no
         resuelve ningún paquete público suyo desde aquí (todo consumo interno sigue siendo
         ProjectReference, ver docs/guia-uso-proyectos.md). Sin credenciales reales configuradas,
         esta fuente no interfiere con dotnet restore/pack locales: NuGet solo pide credenciales
         cuando efectivamente intenta resolver un paquete desde ella. -->
    <add key="bitcode-github" value="https://nuget.pkg.github.com/schildren/index.json" />
  </packageSources>
  <!-- Autenticación exclusivamente por variable de entorno, NUNCA credenciales embebidas. Ver
       docs/guia-uso-proyectos.md, sección "Consumo autenticado del feed NuGet (F8-05)", para cómo
       un consumidor externo define NUGET_GITHUB_ACTOR/NUGET_GITHUB_TOKEN antes de restaurar. -->
  <packageSourceCredentials>
    <bitcode-github>
      <add key="Username" value="%NUGET_GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%NUGET_GITHUB_TOKEN%" />
    </bitcode-github>
  </packageSourceCredentials>
</configuration>
