<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Reporting: Fase 6, módulo 11 del Plan Maestro BitCode: read models de reporting propios
      (patrón Inbox de F1-24/F3-04), exportación a CSV y control de acceso RBAC. El único ejemplo de
      integración de referencia de este primer corte consume los eventos de integración públicos de
      Workflow (Fase 6, módulo 6): `Workflow.WorkflowInstanciaIniciada` y
      `Workflow.WorkflowInstanciaFinalizada`, para poblar `ReporteWorkflowInstancia` -- un read-model
      propio que nunca accede a `WorkflowDbContext`. Ver `docs/guia-reporting.md` para el detalle
      honesto de qué separa este read-model del write-model de Workflow, cómo agregar un consumidor
      nuevo de otro módulo sin tocar el core de Reporting, y qué limitaciones reales trae este primer
      corte.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared.Kernel\Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared.Domain\Shared.Domain.csproj" />
    <ProjectReference Include="..\..\Shared.Application\Shared.Application.csproj" />
    <ProjectReference Include="..\..\Shared.Infrastructure.Persistence\Shared.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\..\Shared.Infrastructure.Security\Shared.Infrastructure.Security.csproj" />
    <ProjectReference Include="..\..\Shared.Infrastructure.Web\Shared.Infrastructure.Web.csproj" />
    <!-- Dependencia declarada por el Plan Maestro (Fase 6, módulo 11: "Dependencias: Events y Data"):
         esta librería referencia BitCode.Platform.Workflow SOLO para reutilizar sus dos eventos de
         integración PÚBLICOS (WorkflowInstanciaIniciadaIntegrationEvent/
         WorkflowInstanciaFinalizadaIntegrationEvent) como contrato de entrada de su ÚNICO consumidor de
         referencia (IEventConsumer(T) de este módulo), nunca referencia ni instancia WorkflowDbContext ni
         ningún comando/query interno de Workflow. Cualquier módulo futuro de Fase 6 puede engancharse a
         Reporting agregando su propio read-model + su propio par de IEventConsumer(T), sin que ese nuevo
         acoplamiento pase por acá: ver docs/guia-reporting.md, sección "Cómo agregar un read-model
         nuevo". -->
    <ProjectReference Include="..\BitCode.Platform.Workflow\BitCode.Platform.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
  </ItemGroup>

</Project>
