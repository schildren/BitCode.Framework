{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "BitCode.Gateway"
  },
  "Jwt": {
    "Issuer": "BitCode.Framework",
    "Audience": "BitCode.Framework.Clients"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "QueueLimit": 0
  },
  "RequestLimits": {
    "MaxRequestBodySizeBytes": 10485760
  },
  "Regional": {
    "CurrentRegion": "primary",
    "TenantRegionAssignments": {}
  },
  "ReverseProxy": {
    "Routes": {
      "sample-workflow-api": {
        "ClusterId": "sample-workflow-api-cluster",
        "Match": {
          "Path": "/api/v{version}/workflows/{**catch-all}"
        }
      },
      "sample-api": {
        "ClusterId": "sample-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "sample-workflow-api-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://sample-workflow-api/"
          }
        }
      },
      "sample-api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://sample-api/"
          }
        }
      }
    }
  }
}
