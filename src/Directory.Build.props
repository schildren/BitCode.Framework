<Project>

  <!-- Encadena el Directory.Build.props de la raíz (TargetFramework/Nullable/ImplicitUsings). MSBuild solo
       auto-importa el Directory.Build.props más cercano en el árbol, por eso hace falta importar el de la
       raíz explícitamente aquí (ver docs/politica-empaquetado.md). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Metadatos NuGet comunes a todos los proyectos de src/ (paquetes públicos del framework, ver
       docs/politica-empaquetado.md). No se usa Central Package Management (Directory.Packages.props);
       esta es la única fuente centralizada de metadatos de empaquetado, no de versiones de PackageReference. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Authors>BitCode.Framework contributors</Authors>
    <Company>BitCode.Framework</Company>
    <Product>BitCode.Framework</Product>
    <Description Condition="'$(Description)' == ''">Building block del framework BitCode.Framework: $(MSBuildProjectName).</Description>
    <PackageTags>bitcode;framework;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/schildren/BitCode.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/schildren/BitCode.Framework</PackageProjectUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/packages/</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Símbolos y Source Link -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Licencia: NO se fija PackageLicenseExpression/PackageLicenseFile a propósito. El ADR 0008
         (docs/adr/0008-licencias-open-core.md) está en estado "Proposed": la licencia del producto es una
         decisión pendiente de aprobación humana explícita (Plan Maestro, sección 13) y ese mismo ADR
         indica que no corresponde fijar de facto una licencia en artefactos antes de esa aprobación.
         `dotnet pack` emitirá la advertencia NU5128/ausencia de licencia; es esperado y no debe silenciarse
         agregando una licencia sin aprobar. Ver docs/politica-empaquetado.md. -->
  </PropertyGroup>

  <!-- Versionado automático basado en git (F1-04, ver docs/politica-versionado.md, sección 2). MinVer calcula
       Version/PackageVersion a partir del tag SemVer alcanzable más cercano (prefijo "v", el default de la
       herramienta) más la distancia de commits desde ese tag ("altura"): si HEAD coincide con un tag, la
       versión es limpia (ej. "0.1.0"); si hay commits después, agrega prerelease + altura (ej.
       "0.1.1-alpha.0.3"). Se prefiere MinVer sobre Nerdbank.GitVersioning porque el repo todavía no tiene
       múltiples líneas de release en paralelo ni necesita height estable entre builds incrementales: MinVer
       resuelve el criterio de aceptación ("Versiones trazables a source") con una única PackageReference y
       sin archivo de configuración adicional (no requiere version.json ni build customizado).
       Trazabilidad al commit exacto: MinVer no agrega el SHA al número de versión SemVer del paquete (Version/
       PackageVersion queda "0.1.0", sin "+sha", para no romper el ordenamiento de versiones de NuGet, que
       ignora metadata de build "+..."), pero sí lo agrega automáticamente al AssemblyInformationalVersion de
       cada DLL (verificado en F1-04: ProductVersion del ensamblado compilado = "0.1.0+<sha-completo>"), y
       Source Link (PublishRepositoryUrl/EmbedUntrackedSources arriba) escribe ese mismo commit SHA completo en
       el elemento <repository commit="..."> del .nuspec de cada paquete generado — ambos verificados
       inspeccionando el .nupkg/.dll reales (ver docs/politica-versionado.md, sección 2). -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerVerbosity>normal</MinVerVerbosity>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />

    <!-- Gate de compatibilidad de API pública (F1-03, ver docs/gate-compatibilidad-api.md).
         Analyzer de Roslyn que compara la superficie pública compilada contra
         PublicAPI.Shipped.txt/PublicAPI.Unshipped.txt de cada proyecto y falla el build
         (RS0016/RS0017/RS0037/RS0022/RS0024/RS0025/RS0026/RS0027) si hay un miembro público
         nuevo, eliminado o cambiado sin declarar en esos archivos. No requiere una versión
         previa publicada: reacciona a cualquier cambio de superficie dentro del propio commit. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Escalona a error las reglas núcleo del gate de compatibilidad (agregar/quitar miembro
       público sin declarar en PublicAPI.*.txt, o cambio de anotación de nulabilidad no
       reflejado). El resto de las reglas del analyzer (p. ej. RS0026, guía de diseño sobre
       sobrecargas con parámetros opcionales) queda como advertencia informativa: no forma
       parte del criterio de aceptación de F1-03 y no debe bloquear el build por hallazgos de
       diseño preexistentes no relacionados con el gate. Ver docs/gate-compatibilidad-api.md. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0022;RS0037</WarningsAsErrors>
  </PropertyGroup>

</Project>
