<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Herramienta de desarrollo, no un artefacto de producción del framework. -->
    <RootNamespace>BitCode.Framework.Tools.OpenApiExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cada Sample.*.Api define su propio tipo Program (top-level statements) en el namespace
         global: referenciar mas de uno en el mismo proyecto sin alias produce una colision de
         nombres ambigua. El atributo Aliases permite distinguirlos con extern alias. -->
    <ProjectReference Include="..\..\src\Shared.Testing\Shared.Testing.csproj" />
    <ProjectReference Include="..\Sample.Api\Sample.Api.csproj" Aliases="SampleApi" />
    <ProjectReference Include="..\Sample.Documents.Api\Sample.Documents.Api.csproj" Aliases="SampleDocumentsApi" />
    <ProjectReference Include="..\Sample.Workflow.Api\Sample.Workflow.Api.csproj" Aliases="SampleWorkflowApi" />
  </ItemGroup>

</Project>
