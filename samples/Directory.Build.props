<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Sample.Api y Sample.Api.Tests son la implementación de referencia del repositorio, no paquetes
       públicos del framework: no se empaquetan. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
