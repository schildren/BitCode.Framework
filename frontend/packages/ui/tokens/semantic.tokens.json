{
  "$description": "Tokens semánticos de BitCode (F7-02). Cada valor referencia un primitivo de primitives.tokens.json mediante alias {grupo.clave}. Organizados por tema (light/dark) para que los componentes usen nombres con significado (superficie, texto, borde, estado) en vez de colores crudos.",
  "light": {
    "color": {
      "surface": { "$type": "color", "$value": "{color.gray.50}", "$description": "Fondo de página." },
      "surfaceElevated": { "$type": "color", "$value": "{color.white}", "$description": "Fondo de tarjetas, paneles, modales." },
      "surfaceSunken": { "$type": "color", "$value": "{color.gray.100}", "$description": "Fondo de áreas hundidas (inputs deshabilitados, zebra de tablas)." },
      "border": { "$type": "color", "$value": "{color.gray.200}" },
      "borderStrong": { "$type": "color", "$value": "{color.gray.300}" },
      "textPrimary": { "$type": "color", "$value": "{color.gray.900}" },
      "textSecondary": { "$type": "color", "$value": "{color.gray.600}" },
      "textDisabled": { "$type": "color", "$value": "{color.gray.400}" },
      "textInverse": { "$type": "color", "$value": "{color.white}" },
      "brandPrimary": { "$type": "color", "$value": "{color.blue.600}" },
      "brandPrimaryHover": { "$type": "color", "$value": "{color.blue.700}" },
      "brandPrimaryActive": { "$type": "color", "$value": "{color.blue.800}" },
      "brandPrimaryText": { "$type": "color", "$value": "{color.blue.700}", "$description": "Uso en texto/enlaces sobre fondo claro (AA)." },
      "onBrandPrimary": { "$type": "color", "$value": "{color.white}", "$description": "Color de texto/ícono sobre brandPrimary." },
      "focusRing": { "$type": "color", "$value": "{color.blue.500}" },
      "success": { "$type": "color", "$value": "{color.green.600}" },
      "successBg": { "$type": "color", "$value": "{color.green.50}" },
      "successBorder": { "$type": "color", "$value": "{color.green.300}" },
      "warning": { "$type": "color", "$value": "{color.amber.600}" },
      "warningBg": { "$type": "color", "$value": "{color.amber.50}" },
      "warningBorder": { "$type": "color", "$value": "{color.amber.300}" },
      "error": { "$type": "color", "$value": "{color.red.600}" },
      "errorBg": { "$type": "color", "$value": "{color.red.50}" },
      "errorBorder": { "$type": "color", "$value": "{color.red.300}" },
      "info": { "$type": "color", "$value": "{color.blue.600}" },
      "infoBg": { "$type": "color", "$value": "{color.blue.50}" },
      "infoBorder": { "$type": "color", "$value": "{color.blue.300}" }
    }
  },
  "dark": {
    "color": {
      "surface": { "$type": "color", "$value": "{color.gray.900}" },
      "surfaceElevated": { "$type": "color", "$value": "{color.gray.800}" },
      "surfaceSunken": { "$type": "color", "$value": "{color.gray.900}" },
      "border": { "$type": "color", "$value": "{color.gray.700}" },
      "borderStrong": { "$type": "color", "$value": "{color.gray.600}" },
      "textPrimary": { "$type": "color", "$value": "{color.gray.50}" },
      "textSecondary": { "$type": "color", "$value": "{color.gray.300}" },
      "textDisabled": { "$type": "color", "$value": "{color.gray.600}" },
      "textInverse": { "$type": "color", "$value": "{color.gray.900}" },
      "brandPrimary": { "$type": "color", "$value": "{color.blue.500}" },
      "brandPrimaryHover": { "$type": "color", "$value": "{color.blue.400}" },
      "brandPrimaryActive": { "$type": "color", "$value": "{color.blue.300}" },
      "brandPrimaryText": { "$type": "color", "$value": "{color.blue.300}" },
      "onBrandPrimary": { "$type": "color", "$value": "{color.gray.900}" },
      "focusRing": { "$type": "color", "$value": "{color.blue.400}" },
      "success": { "$type": "color", "$value": "{color.green.300}" },
      "successBg": { "$type": "color", "$value": "{color.green.700}" },
      "successBorder": { "$type": "color", "$value": "{color.green.500}" },
      "warning": { "$type": "color", "$value": "{color.amber.300}" },
      "warningBg": { "$type": "color", "$value": "{color.amber.700}" },
      "warningBorder": { "$type": "color", "$value": "{color.amber.500}" },
      "error": { "$type": "color", "$value": "{color.red.300}" },
      "errorBg": { "$type": "color", "$value": "{color.red.700}" },
      "errorBorder": { "$type": "color", "$value": "{color.red.500}" },
      "info": { "$type": "color", "$value": "{color.blue.300}" },
      "infoBg": { "$type": "color", "$value": "{color.blue.700}" },
      "infoBorder": { "$type": "color", "$value": "{color.blue.500}" }
    }
  }
}
